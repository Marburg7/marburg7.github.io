# AI Provider Configuration (Server-Side Only — NEVER expose in frontend)
# Optional: Add GEMINI_API_KEY to enable live Gemini tool-calling responses.
# If left blank, the server runs in honest grounded local-orchestrator mode using
# selective CV retrieval + controlled tools without external API calls.

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server & Security Settings
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://syedshahbuddin.github.io
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_MESSAGE_CHARS=6000
MAX_HISTORY_TURNS=10
